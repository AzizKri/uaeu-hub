VITE_API_URL=https://api.uaeu.chat
VITE_ASSETS_URL=https://cdn.uaeu.chat
VITE_WS_URL=wss://wss.uaeu.chat

# This value is bundled into the client and is not a real secret.
# It must match the current WS_SECRET server-side signing value until websocket auth is redesigned.
VITE_WS_SECRET_KEY=replace-with-production-ws-signing-value
